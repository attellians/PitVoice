<Page
    x:Class="PitVoice.App.Pages.OverlayPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="RowIcon" TargetType="controls:SectionIcon">
            <Setter Property="Size" Value="28" />
            <Setter Property="Section" Value="Overlay" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <!-- The state of the indicator in the headset: grey, green "в шлеме", red "ошибка VR" (spec: Color for state only). -->
        <Style x:Key="VrState" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VrDot" TargetType="Ellipse" BasedOn="{StaticResource StateDot}">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusTone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr NavOverlay}" />

        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding SaveError, Converter={StaticResource NotEmpty}}"
            Message="{Binding SaveError}"
            Severity="Error" />

        <!-- The top card: "Показывать оверлей" and under it "Режим VR" (spec: Indicator settings, VR mode setting). -->
        <Border Style="{StaticResource Card}" Padding="16,8">
            <StackPanel>
                <Border Style="{StaticResource ListRowFirst}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Layer24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayEnabled}" />
                        <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Enabled}" />
                    </Grid>
                </Border>
                <!-- The label, the dot and the state in one line, the state cut with an ellipsis; the switch on the right. -->
                <Border Style="{StaticResource ListRow}" Visibility="{Binding HasVr, Converter={StaticResource Visible}}">
                    <Grid DataContext="{Binding Vr}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="HeadsetVr24" />
                        <TextBlock Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource Body}" Text="{loc:Tr VrLabel}" />
                        <Ellipse Grid.Column="2" Style="{StaticResource VrDot}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="0,0,16,0"
                            Style="{StaticResource VrState}"
                            Text="{Binding StatusText}"
                            ToolTip="{Binding StatusText}" />
                        <ui:ToggleSwitch
                            Grid.Column="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{loc:Tr VrLabel}"
                            IsChecked="{Binding Enabled}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Card}" Padding="16,8">
                <StackPanel>
                    <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayLookSection}" />
                    <Border Style="{StaticResource ListRowFirst}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Eye24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayKindLabel}" />
                            <ComboBox
                                Grid.Column="2"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Kinds}"
                                SelectedValue="{Binding Kind}"
                                SelectedValuePath="Key"
                                Style="{StaticResource RowCombo}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Resize24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayScaleLabel}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Slider
                                    Maximum="{Binding MaxScale}"
                                    Minimum="{Binding MinScale}"
                                    Style="{StaticResource RowSlider}"
                                    Value="{Binding Scale}" />
                                <TextBlock Width="44" Margin="8,0,0,0" Style="{StaticResource Body}" Text="{Binding Scale, StringFormat={}{0}%}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Blur24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayOpacityLabel}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Slider
                                    Maximum="{Binding MaxOpacity}"
                                    Minimum="{Binding MinOpacity}"
                                    Style="{StaticResource RowSlider}"
                                    Value="{Binding Opacity}" />
                                <TextBlock Width="44" Margin="8,0,0,0" Style="{StaticResource Body}" Text="{Binding Opacity, StringFormat={}{0}%}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- One row: "Положение индикатора" with a hint, "Переместить" and the reset icon button (spec: Place row). -->
            <Border Style="{StaticResource Card}" Padding="16,8">
                <StackPanel>
                    <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayPlaceSection}" />
                    <Border Style="{StaticResource ListRowFirst}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="ArrowMove24" />
                            <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="{loc:Tr OverlayPlaceLabel}" />
                                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionWrap}" Text="{loc:Tr OverlayPlaceHint}" />
                            </StackPanel>
                            <ui:Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Appearance="Primary"
                                Command="{Binding ToggleMoveCommand}"
                                Content="{Binding MoveText}" />
                            <ui:Button
                                Grid.Column="3"
                                Width="36"
                                Height="36"
                                Margin="8,0,0,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{loc:Tr OverlayResetPosition}"
                                Command="{Binding ResetPositionCommand}"
                                IsEnabled="{Binding HasCustomPosition}"
                                ToolTip="{loc:Tr OverlayResetPosition}"
                                ToolTipService.ShowOnDisabled="True">
                                <ui:SymbolIcon FontSize="16" Symbol="ArrowReset24" />
                            </ui:Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
