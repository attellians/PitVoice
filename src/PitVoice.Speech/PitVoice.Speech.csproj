<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PitVoice.Speech</RootNamespace>
    <!-- LibraryImport (UTF-8 calls into libvosk) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Audio capture (NAudio), WAV loading, resampling to 16 kHz mono and speech recognition (Vosk).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitVoice.Core\PitVoice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated by tools/cue-gen; regenerate there, do not edit by hand. -->
    <EmbeddedResource Include="Cues\*.wav" LogicalName="PitVoice.Speech.Cues.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PitVoice.Speech.Tests" />
  </ItemGroup>

</Project>
