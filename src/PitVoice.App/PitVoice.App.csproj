<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Lets the solution build on Linux CI; the app itself runs only on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF bindings need real cultures (en-US at least); Directory.Build.props switches them off for the rest. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>PitVoice</AssemblyName>
    <RootNamespace>PitVoice.App</RootNamespace>
    <Description>PitVoice tray application: status icon, settings window, command check, command reference and models.</Description>
    <!-- Generated by tools/icon-gen; regenerate there, do not edit by hand. -->
    <ApplicationIcon>Assets\pitvoice.ico</ApplicationIcon>
    <!-- Own Main in Program.cs: the installer commands run before the app starts (design decision 3). -->
    <StartupObject>PitVoice.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Resource Include="Assets\pitvoice.ico" />
    <EmbeddedResource Include="ui\*.json" LogicalName="PitVoice.App.ui.%(Filename)%(Extension)" />
    <EmbeddedResource Include="ThirdParty.json" LogicalName="PitVoice.App.ThirdParty.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitVoice.Host\PitVoice.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\languages\*.yaml" Link="languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\manifest.json" Link="models\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PitVoice.App.Tests" />
  </ItemGroup>

</Project>
