<Page
    x:Class="PitVoice.App.Pages.AboutPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Name="Root">
    <StackPanel Margin="24,16,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr NavAbout}" />

        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:SectionIcon
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Fallback="PitVoice"
                    Section="About"
                    Size="44"
                    Symbol="Info24" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Style="{StaticResource Body}">
                        <Run Text="PitVoice" />
                        <Run Text="{Binding Version, Mode=OneTime}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionWrap}" Text="{loc:Tr ProjectLicense}" />
                    <ui:HyperlinkButton
                        Margin="-8,4,0,0"
                        Command="{Binding OpenCommand}"
                        CommandParameter="{Binding Repository, Mode=OneTime}"
                        Content="{Binding Repository, Mode=OneTime}" />
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding CopyAddress, Converter={StaticResource NotEmptyVisible}}">
                        <TextBlock Style="{StaticResource CaptionWrap}" Text="{loc:Tr BrowserFailed}" />
                        <ui:TextBox IsReadOnly="True" Text="{Binding CopyAddress, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Speech models with their licenses: a list card (spec: About section). -->
        <Border Style="{StaticResource Card}" Padding="16,8">
            <StackPanel>
                <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr ModelsLicenses}" />
                <ItemsControl AlternationCount="10000" ItemsSource="{Binding Models, Mode=OneTime}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}" MinHeight="36" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Margin="16,0" Style="{StaticResource Caption}" Text="{Binding License}" />
                                    <ui:HyperlinkButton
                                        Grid.Column="2"
                                        Padding="4,0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenCommand, ElementName=Root}"
                                        CommandParameter="{Binding Url}"
                                        Content="{Binding Url}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,8">
            <StackPanel>
                <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr ComponentsLicenses}" />
                <ItemsControl ItemsSource="{Binding Components, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Style="{StaticResource ChipText}" Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
