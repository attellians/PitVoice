<Page
    x:Class="PitVoice.App.Pages.HomePage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Name="Root">
    <Page.Resources>
        <!-- A state dot: grey (waits), green (works) or red (a problem) by its tone (spec: Color for state only). -->
        <Style x:Key="StateDotOfTone" TargetType="Ellipse" BasedOn="{StaticResource StateDot}">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A result chip: a muted fill and the text in the color of the outcome (spec: Recent phrases). -->
        <Style x:Key="ResultChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Background" Value="{DynamicResource StateOkTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Warn}">
                    <Setter Property="Background" Value="{DynamicResource StateWarnTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Background" Value="{DynamicResource StateErrorTintBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultChipText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Warn}">
                    <Setter Property="Foreground" Value="{DynamicResource StateWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            A check tile in one line: the icon with the state dot in its corner (or the dot before the text), the value
            trimmed with an ellipsis; the state in words is in the tooltip and the screen reader name (spec: Home check
            tiles). A tile with a problem is a muted red button to the settings.
        -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:Tile}">
            <Grid AutomationProperties.Name="{Binding AccessibleName}" ToolTip="{Binding ToolTip}">
                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Tile}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAction}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource StateErrorTintBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Margin="0,0,10,0">
                            <controls:SectionIcon
                                Fallback="{Binding Value}"
                                Section="{Binding Section}"
                                Size="32"
                                Symbol="{Binding Symbol}" />
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="0,0,-2,-2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Stroke="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                StrokeThickness="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse" BasedOn="{StaticResource StateDotOfTone}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DotInText}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsAction}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <Ellipse Grid.Column="1" Visibility="{Binding DotInText, Converter={StaticResource Visible}}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse" BasedOn="{StaticResource StateDotOfTone}">
                                    <Setter Property="Margin" Value="0,0,8,0" />
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Grid.Column="2" Text="{Binding Value}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAction}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:SymbolIcon
                            Grid.Column="3"
                            Margin="6,0,0,0"
                            FontSize="16"
                            Foreground="{DynamicResource StateErrorBrush}"
                            Symbol="ChevronRight24"
                            Visibility="{Binding IsAction, Converter={StaticResource Visible}}" />
                    </Grid>
                </Border>
                <!-- The whole tile with a problem is the button "Назначить кнопку" (spec: Button not assigned). -->
                <Button
                    AutomationProperties.Name="{Binding AccessibleName}"
                    Command="{Binding DataContext.OpenSettingsCommand, ElementName=Root}"
                    Cursor="Hand"
                    Visibility="{Binding IsAction, Converter={StaticResource Visible}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr NavHome}" />

        <!-- WPF-UI InfoBar does not show its content, so the buttons are a row under it. -->
        <StackPanel Margin="0,0,0,12" Visibility="{Binding CrashOfferVisible, Converter={StaticResource Visible}}">
            <ui:InfoBar
                Title="{loc:Tr CrashTitle}"
                IsClosable="False"
                IsOpen="True"
                Message="{loc:Tr CrashMessage}"
                Severity="Error" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Command="{Binding CollectAfterCrashCommand}" Content="{loc:Tr DiagCollectButton}" />
                <ui:Button Margin="8,0,0,0" Command="{Binding DismissCrashCommand}" Content="{loc:Tr CrashDismiss}" />
            </StackPanel>
        </StackPanel>

        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding CollectError, Converter={StaticResource NotEmpty}}"
            Message="{Binding CollectError}"
            Severity="Error" />

        <ui:InfoBar
            Title="{loc:Tr ElevationTitle}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding ElevationHintVisible}"
            Message="{loc:Tr ElevationHint}"
            Severity="Warning" />

        <!-- The status card in one line: icon, title, the action on the right; the hint is the tooltip (spec: Home status card). -->
        <Border
            Padding="16,12"
            DataContext="{Binding Status}"
            Style="{StaticResource Card}"
            ToolTip="{Binding ToolTip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- The green mark of "ready" is the icon itself: a green check on its green tint. -->
                <controls:SectionIcon
                    Margin="0,0,12,0"
                    Fallback="{Binding Title}"
                    Section="{Binding Section}"
                    Size="36"
                    Symbol="{Binding Symbol}" />
                <TextBlock
                    Grid.Column="1"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Style="{StaticResource Body}"
                    Text="{Binding Title}" />
                <ui:Button
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    Appearance="Primary"
                    Command="{Binding DataContext.StatusActionCommand, ElementName=Root}"
                    Content="{Binding ActionText}"
                    Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
            </Grid>
        </Border>

        <!--
            The three check tiles in a row (spec: Home check tiles). In a narrow window they stand one under another, so
            each keeps its one line readable instead of cutting "iRacing не запущен" to "iRacing…".
        -->
        <UniformGrid x:Name="Tiles" Margin="-6,0,-6,20">
            <UniformGrid.Resources>
                <Style TargetType="ContentControl">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="ContentTemplate" Value="{StaticResource TileTemplate}" />
                    <Setter Property="Margin" Value="6,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, ElementName=Tiles, Converter={StaticResource NarrowerThan}, ConverterParameter=600}" Value="True">
                            <Setter Property="Margin" Value="6,0,6,8" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Resources>
            <UniformGrid.Style>
                <Style TargetType="UniformGrid">
                    <Setter Property="Rows" Value="1" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource NarrowerThan}, ConverterParameter=600}" Value="True">
                            <Setter Property="Rows" Value="3" />
                            <Setter Property="Columns" Value="1" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </UniformGrid.Style>
            <ContentControl Content="{Binding Microphone}" />
            <ContentControl Content="{Binding Ptt}" />
            <ContentControl Content="{Binding Game}" />
        </UniformGrid>

        <!-- Recent phrases: one line each, the text, a result chip and the time; details in the tooltip (spec: Recent phrases). -->
        <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="{loc:Tr RecentPhrases}" />
        <TextBlock
            Style="{StaticResource CaptionWrap}"
            Text="{loc:Tr NoPhrasesYet}"
            Visibility="{Binding NoPhrases, Converter={StaticResource Visible}}" />
        <Border Style="{StaticResource Card}" Padding="16,4" Visibility="{Binding NoPhrases, Converter={StaticResource NotVisible}}">
            <ItemsControl AlternationCount="10000" ItemsSource="{Binding Phrases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhraseRow}">
                        <Border Background="Transparent" Style="{StaticResource ListRow}" ToolTip="{Binding ToolTip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Text}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDim}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Grid.Column="1" MaxWidth="260" Margin="12,0,0,0" Style="{StaticResource ResultChip}">
                                    <TextBlock Style="{StaticResource ResultChipText}" Text="{Binding Chip}" />
                                </Border>
                                <TextBlock
                                    Grid.Column="2"
                                    MinWidth="44"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource Caption}"
                                    Text="{Binding Time}"
                                    TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</Page>
