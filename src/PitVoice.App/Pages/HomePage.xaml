<Page
    x:Class="PitVoice.App.Pages.HomePage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    x:Name="Root">
    <Page.Resources>
        <!-- A word of state: grey, green, amber or red by its tone (spec: Color for state only). -->
        <Style x:Key="StateText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Warn}">
                    <Setter Property="Foreground" Value="{DynamicResource StateWarnBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StateDotOfTone" TargetType="Ellipse" BasedOn="{StaticResource StateDot}">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Ok}">
                    <Setter Property="Fill" Value="{DynamicResource StateOkBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:StateTone.Problem}">
                    <Setter Property="Fill" Value="{DynamicResource StateErrorBrush}" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A check tile: icon and title, the value, the state word with a dot, a detail line (spec: Home check tiles). -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type vm:Tile}">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionIcon
                            Margin="0,0,10,0"
                            Fallback="{Binding Title}"
                            Section="{Binding Section}"
                            Size="32"
                            Symbol="{Binding Symbol}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionWrap}" Text="{Binding Title}" />
                    </Grid>
                    <TextBlock
                        Margin="0,10,0,0"
                        Style="{StaticResource BodyWrap}"
                        Text="{Binding Value}" />
                    <WrapPanel
                        Margin="0,4,0,0"
                        Visibility="{Binding StateText, Converter={StaticResource NotEmptyVisible}}">
                        <Ellipse Style="{StaticResource StateDotOfTone}" />
                        <TextBlock Style="{StaticResource StateText}" Text="{Binding StateText}" />
                        <ui:HyperlinkButton
                            Margin="8,-6,0,-6"
                            Padding="4,2"
                            Command="{Binding DataContext.OpenSettingsCommand, ElementName=Root}"
                            Content="{loc:Tr AssignLink}"
                            FontSize="13"
                            Visibility="{Binding ShowAssign, Converter={StaticResource Visible}}" />
                    </WrapPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        Style="{StaticResource CaptionWrap}"
                        Text="{Binding Detail}"
                        Visibility="{Binding Detail, Converter={StaticResource NotEmptyVisible}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0" Style="{StaticResource PageTitle}" Text="{loc:Tr NavHome}" />
            <!-- "25 фраз, 23 применено" (spec: Phrase counter). -->
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Style="{StaticResource Caption}"
                Text="{Binding Counter}"
                Visibility="{Binding Counter, Converter={StaticResource NotEmptyVisible}}" />
        </Grid>

        <!-- WPF-UI InfoBar does not show its content, so the buttons are a row under it. -->
        <StackPanel Margin="0,0,0,12" Visibility="{Binding CrashOfferVisible, Converter={StaticResource Visible}}">
            <ui:InfoBar
                Title="{loc:Tr CrashTitle}"
                IsClosable="False"
                IsOpen="True"
                Message="{loc:Tr CrashMessage}"
                Severity="Error" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ui:Button Appearance="Primary" Command="{Binding CollectAfterCrashCommand}" Content="{loc:Tr DiagCollectButton}" />
                <ui:Button Margin="8,0,0,0" Command="{Binding DismissCrashCommand}" Content="{loc:Tr CrashDismiss}" />
            </StackPanel>
        </StackPanel>

        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding CollectError, Converter={StaticResource NotEmpty}}"
            Message="{Binding CollectError}"
            Severity="Error" />

        <ui:InfoBar
            Title="{loc:Tr ElevationTitle}"
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding ElevationHintVisible}"
            Message="{loc:Tr ElevationHint}"
            Severity="Warning" />

        <!-- The status card (spec: Home status card). -->
        <Border Style="{StaticResource Card}" Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:SectionIcon
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    Fallback="{Binding StatusTitle}"
                    Section="{Binding StatusSection}"
                    Size="44"
                    Symbol="{Binding StatusSymbol}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- The green mark of "ready" is the icon itself: a green check on its green tint. -->
                    <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyWrap}"
                            Text="{Binding StatusTitle}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionWrap}" Text="{Binding StatusHint}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The three check tiles (spec: Home check tiles). -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Content="{Binding Microphone}" ContentTemplate="{StaticResource TileTemplate}" />
            <ContentControl Grid.Column="2" Content="{Binding Ptt}" ContentTemplate="{StaticResource TileTemplate}" />
            <ContentControl Grid.Column="4" Content="{Binding Game}" ContentTemplate="{StaticResource TileTemplate}" />
        </Grid>

        <!-- Recent phrases: plain rows, the outcome and the response on the right in grey (spec: Recent phrases). -->
        <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="{loc:Tr RecentPhrases}" />
        <TextBlock
            Style="{StaticResource CaptionWrap}"
            Text="{loc:Tr NoPhrasesYet}"
            Visibility="{Binding NoPhrases, Converter={StaticResource Visible}}" />
        <Border Style="{StaticResource Card}" Padding="16,4" Visibility="{Binding NoPhrases, Converter={StaticResource NotVisible}}">
            <ItemsControl AlternationCount="10000" ItemsSource="{Binding Phrases}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PhraseRow}">
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" MaxWidth="340" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyWrap}" Text="{Binding Text}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource ErrorText}"
                                        Text="{Binding Detail}"
                                        Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StateText}">
                                                <Setter Property="FontSize" Value="14" />
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding Outcome, Mode=OneWay}" /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text=" · " /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Response, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Style="{StaticResource Caption}"
                                        Text="{Binding Time}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</Page>
