<Page
    x:Class="PitVoice.App.Pages.ModelsPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:host="clr-namespace:PitVoice.Host;assembly=PitVoice.Host"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!-- The circle with the language code: green when in use, neutral when installed or downloading, dashed when absent. -->
        <Style x:Key="CodeCircle" TargetType="Ellipse">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Fill" Value="{DynamicResource NeutralCircleBrush}" />
            <Setter Property="Stroke" Value="{x:Null}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static host:ModelState.InUse}">
                    <Setter Property="Fill" Value="{DynamicResource SectionModelsTintBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static host:ModelState.NotInstalled}">
                    <Setter Property="Fill" Value="Transparent" />
                    <Setter Property="Stroke" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="StrokeDashArray" Value="3 2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CodeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static host:ModelState.InUse}">
                    <Setter Property="Foreground" Value="{DynamicResource SectionModelsBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static host:ModelState.NotInstalled}">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModelStateText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static host:ModelState.InUse}">
                    <Setter Property="Foreground" Value="{DynamicResource StateOkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Margin="0,0,0,4" Style="{StaticResource PageTitle}" Text="{loc:Tr NavModels}" />
        <TextBlock Margin="0,0,0,16" Style="{StaticResource CaptionWrap}" Text="{Binding LanguageTitle}" />
        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding Message, Converter={StaticResource NotEmpty}}"
            Message="{Binding Message}"
            Severity="Error" />

        <!-- One list card, a row per model (spec: Models in the window). -->
        <Border Style="{StaticResource Card}" Padding="16,4">
            <ItemsControl AlternationCount="10000" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModelRow}">
                        <Border Style="{StaticResource ListRow}" Padding="0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Ellipse Style="{StaticResource CodeCircle}" />
                                    <TextBlock Style="{StaticResource CodeText}" Text="{Binding Code}" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold" Style="{StaticResource Body}" Text="{Binding LanguageName}" />
                                        <Ellipse
                                            Margin="10,0,6,0"
                                            Fill="{DynamicResource StateOkBrush}"
                                            Style="{StaticResource StateDot}"
                                            Visibility="{Binding IsInUse, Converter={StaticResource Visible}}" />
                                        <TextBlock Margin="10,0,0,0" Style="{StaticResource ModelStateText}" Text="{Binding StateText}">
                                            <TextBlock.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource ModelStateText}" />
                                            </TextBlock.Resources>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionWrap}" Text="{Binding Details}" />
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}">
                                        <ProgressBar
                                            Height="4"
                                            Maximum="100"
                                            Value="{Binding Percent, Mode=OneWay}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource ErrorText}"
                                        Text="{Binding Error}"
                                        Visibility="{Binding Error, Converter={StaticResource NotEmptyVisible}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                    <!-- "Скачать" is the one primary button of the page (spec: One primary button). -->
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding DownloadCommand}"
                                        Content="{loc:Tr DownloadButton}"
                                        Visibility="{Binding CanDownload, Converter={StaticResource Visible}}" />
                                    <ui:Button
                                        Command="{Binding CancelCommand}"
                                        Content="{loc:Tr CancelButton}"
                                        Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}" />
                                    <ui:Button
                                        Command="{Binding DeleteCommand}"
                                        Content="{loc:Tr DeleteButton}"
                                        Visibility="{Binding CanDelete, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</Page>
