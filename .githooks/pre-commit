#!/bin/sh
# Auto-bump the patch number in VERSION on every commit.
#
# Format: MAJOR.MINOR.PATCH (e.g. 1.3.15), each segment 0..99.
# PATCH is bumped on every commit; when it exceeds 99 it rolls over into
# MINOR, and MINOR rolls over into MAJOR the same way. A manually staged
# VERSION is committed as is (no extra bump).
#
# Skip once:   SKIP_VERSION_BUMP=1 git commit ...
# Enabled by:  git config core.hooksPath .githooks

set -e

VERSION_FILE="VERSION"

if [ "$SKIP_VERSION_BUMP" = "1" ]; then
    exit 0
fi

if [ ! -f "$VERSION_FILE" ]; then
    echo "pre-commit: $VERSION_FILE not found, creating 0.0.1" >&2
    printf '0.0.1\n' > "$VERSION_FILE"
    git add "$VERSION_FILE"
    exit 0
fi

# If the user already staged a change to VERSION (manual major/minor bump),
# keep it as is.
if ! git diff --cached --quiet -- "$VERSION_FILE"; then
    echo "pre-commit: VERSION changed manually, keeping $(cat "$VERSION_FILE")" >&2
    exit 0
fi

current=$(tr -d ' \r\n' < "$VERSION_FILE")

case "$current" in
    *'<<<<<<<'*|*'>>>>>>>'*)
        echo "pre-commit: $VERSION_FILE has unresolved merge conflict markers" >&2
        exit 1
        ;;
esac

major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}
patch=${rest#*.}

case "$major$minor$patch" in
    ''|*[!0-9]*)
        echo "pre-commit: $VERSION_FILE has invalid version '$current' (expected MAJOR.MINOR.PATCH)" >&2
        exit 1
        ;;
esac

# Bump PATCH; carry into MINOR / MAJOR when a segment exceeds 99.
#   0.0.99  -> 0.1.0
#   0.99.99 -> 1.0.0
patch=$((patch + 1))
if [ "$patch" -gt 99 ]; then
    patch=0
    minor=$((minor + 1))
    if [ "$minor" -gt 99 ]; then
        minor=0
        major=$((major + 1))
    fi
fi
new="$major.$minor.$patch"

printf '%s\n' "$new" > "$VERSION_FILE"
git add "$VERSION_FILE"

echo "pre-commit: version $current -> $new" >&2
exit 0
