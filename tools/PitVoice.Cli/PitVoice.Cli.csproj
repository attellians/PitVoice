<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pitvoice-cli</AssemblyName>
    <RootNamespace>PitVoice.Cli</RootNamespace>
    <Description>Console tool: parse a text command and validate language packs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PitVoice.Core\PitVoice.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\languages\*.yaml" Link="languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
