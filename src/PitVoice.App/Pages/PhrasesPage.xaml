<Page
    x:Class="PitVoice.App.Pages.PhrasesPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24,16,24,24">
        <!-- The page lives inside "Commands": its own back arrow and the path "Команды / Свои фразы" (design D8, D13). -->
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button
                x:Name="BackButton"
                Width="36"
                Height="36"
                Margin="-8,0,8,0"
                Padding="0"
                VerticalAlignment="Center"
                Appearance="Transparent"
                BorderThickness="0"
                Click="OnBack"
                ToolTip="{loc:Tr BackButton}">
                <ui:SymbolIcon FontSize="18" Symbol="ArrowLeft24" />
            </ui:Button>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    FontSize="20"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MouseLeftButtonUp="OnBack"
                    Text="{loc:Tr NavCommands}" />
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="/" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="{loc:Tr PhrasesTitle}" />
            </WrapPanel>
        </Grid>
        <TextBlock Margin="0,0,0,16" Style="{StaticResource Caption}" Text="{Binding LanguageTitle}" />

        <!-- No model: the words cannot be checked, so check and save are off (spec: Builder without a speech model). -->
        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding NoModel}"
            Message="{loc:Tr PhrasesNoModel}"
            Severity="Warning" />

        <!-- A file the page cannot show is not applied; "Начать заново" drops it from the draft (design D10). -->
        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding OldFile}"
            Message="{loc:Tr PhrasesOldFile}"
            Severity="Informational">
            <ui:Button Margin="0,0,0,8" Command="{Binding StartOverCommand}" Content="{loc:Tr PhrasesStartOver}" />
        </ui:InfoBar>

        <!-- The rows: phrase, command, variant, delete; the message under each row (spec: Phrase rows, Row check while typing). -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource CaptionWrap}" Text="{loc:Tr PhrasesHint}" />
                <TextBlock
                    Margin="0,8"
                    Style="{StaticResource Caption}"
                    Text="{loc:Tr PhrasesEmpty}"
                    Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                <ItemsControl x:Name="RowList" AlternationCount="10000" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OwnPhraseRow}">
                            <Border Style="{StaticResource ListRow}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" MinWidth="120" />
                                            <ColumnDefinition Width="*" MinWidth="100" />
                                            <ColumnDefinition Width="1.4*" MinWidth="110" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox
                                            x:Name="PhraseBox"
                                            VerticalAlignment="Center"
                                            ClearButtonEnabled="False"
                                            PlaceholderText="{loc:Tr PhraseText}"
                                            Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                        <ComboBox
                                            x:Name="CommandBox"
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ItemsSource="{Binding DataContext.Commands, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            SelectedItem="{Binding Command}"
                                            ToolTip="{loc:Tr PhraseCommand}" />
                                        <ComboBox
                                            x:Name="VariantBox"
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            IsEnabled="{Binding HasVariants}"
                                            ItemsSource="{Binding Variants}"
                                            SelectedItem="{Binding Variant}"
                                            ToolTip="{loc:Tr PhraseVariant}" />
                                        <ui:Button
                                            x:Name="DeleteButton"
                                            Grid.Column="3"
                                            Width="36"
                                            Height="36"
                                            Margin="8,0,0,0"
                                            Padding="0"
                                            VerticalAlignment="Center"
                                            Appearance="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding RemoveCommand}"
                                            ToolTip="{loc:Tr PhraseDelete}">
                                            <ui:SymbolIcon FontSize="16" Symbol="Delete24" />
                                        </ui:Button>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Style="{StaticResource ErrorText}"
                                        Text="{Binding Error}"
                                        Visibility="{Binding Error, Converter={StaticResource NotEmptyVisible}}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource StateWarnBrush}"
                                        Style="{StaticResource CaptionWrap}"
                                        Text="{Binding Warning}"
                                        Visibility="{Binding Warning, Converter={StaticResource NotEmptyVisible}}" />
                                </StackPanel>
                            </Border>
                            <!-- In a narrow window the phrase takes the whole first line and the lists go under it (design D13). -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource NarrowerThan}, ConverterParameter=560}" Value="True">
                                    <Setter TargetName="PhraseBox" Property="Grid.ColumnSpan" Value="4" />
                                    <Setter TargetName="CommandBox" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="CommandBox" Property="Grid.Column" Value="0" />
                                    <Setter TargetName="CommandBox" Property="Margin" Value="0,8,0,0" />
                                    <Setter TargetName="VariantBox" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="VariantBox" Property="Grid.Column" Value="1" />
                                    <Setter TargetName="VariantBox" Property="Grid.ColumnSpan" Value="2" />
                                    <Setter TargetName="VariantBox" Property="Margin" Value="8,8,0,0" />
                                    <Setter TargetName="DeleteButton" Property="Grid.Row" Value="1" />
                                    <Setter TargetName="DeleteButton" Property="Margin" Value="8,8,0,0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button Margin="0,12,0,0" Command="{Binding AddRowCommand}" Content="{loc:Tr PhrasesAdd}" Icon="{ui:SymbolIcon Add24}" />
            </StackPanel>
        </Border>

        <!-- The check field parses a phrase with the draft; nothing reaches the game (spec: Phrase check field). -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr PhrasesCheckTitle}" />
                <TextBlock Margin="0,2,0,8" Style="{StaticResource CaptionWrap}" Text="{loc:Tr PhrasesCheckHint}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        VerticalAlignment="Center"
                        ClearButtonEnabled="False"
                        KeyDown="OnCheckKeyDown"
                        PlaceholderText="{loc:Tr PhraseText}"
                        Text="{Binding CheckText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CheckCommand}"
                        Content="{loc:Tr PhrasesCheckButton}" />
                </Grid>
                <Grid Margin="0,8,0,0" Visibility="{Binding CheckResult, Converter={StaticResource NotEmptyVisible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Fill="{DynamicResource StateOkBrush}" Style="{StaticResource StateDot}" Visibility="{Binding CheckUnderstood, Converter={StaticResource Visible}}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyWrap}" Text="{Binding CheckResult}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Draft state and the only accent button (design D13). -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <Grid Visibility="{Binding IsChanged, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Fill="{DynamicResource StateWarnBrush}" Style="{StaticResource StateDot}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionWrap}" Text="{loc:Tr PhrasesUnsaved}" />
                </Grid>
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding SaveError}"
                    Visibility="{Binding SaveError, Converter={StaticResource NotEmptyVisible}}" />
            </StackPanel>
            <ui:Button
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding DiscardCommand}"
                Content="{loc:Tr PhrasesDiscard}" />
            <ui:Button
                Grid.Column="2"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Appearance="Primary"
                Command="{Binding SaveDraftCommand}"
                Content="{loc:Tr PhrasesSave}" />
        </Grid>
    </StackPanel>
</Page>
