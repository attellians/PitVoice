<Page
    x:Class="PitVoice.App.Pages.CommandsPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <StackPanel Margin="24,16,24,24">
        <TextBlock Margin="0,0,0,4" Style="{StaticResource PageTitle}" Text="{loc:Tr NavCommands}" />
        <TextBlock Margin="0,0,0,16" Style="{StaticResource Caption}" Text="{Binding LanguageTitle}" />

        <!-- "Свои слова" first: icon, state in one line, buttons on the right, path and errors under it (spec: User additions in the reference). -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SectionIcon
                        Margin="0,0,12,0"
                        Fallback="{loc:Tr AdditionsTitle}"
                        Section="Commands"
                        Size="32"
                        Symbol="Edit24" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr AdditionsTitle}" />
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Fill="{DynamicResource StateOkBrush}" Style="{StaticResource StateDot}" Visibility="{Binding AdditionsApplied, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionWrap}" Text="{Binding AdditionsState}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Command="{Binding OpenFileCommand}" Content="{loc:Tr OpenFileButton}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding ReloadCommand}" Content="{loc:Tr ReloadButton}" />
                    </StackPanel>
                </Grid>
                <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionWrap}" Text="{Binding AdditionsFile}" />
                <ItemsControl ItemsSource="{Binding AdditionIssues}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource ErrorText}" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource StateWarnBrush}"
                    Style="{StaticResource CaptionWrap}"
                    Text="{Binding MissingWords}"
                    Visibility="{Binding MissingWords, Converter={StaticResource NotEmptyVisible}}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding Message}"
                    Visibility="{Binding Message, Converter={StaticResource NotEmptyVisible}}" />
            </StackPanel>
        </Border>

        <!-- The pack did not load: the reason instead of the cards (spec: Pack failed to load). -->
        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding PackError, Converter={StaticResource NotEmpty}}"
            Message="{Binding PackError}"
            Severity="Error" />

        <!-- A card per group: icon, name, description, example chips, the collapsed "Слова группы" block (design D5). -->
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:GroupEntry}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:SectionIcon
                                    Margin="0,0,12,0"
                                    Fallback="{Binding Name}"
                                    Section="{Binding Section}"
                                    Size="32"
                                    Symbol="{Binding Symbol}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionWrap}" Text="{Binding Description}" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Examples}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Collapsed by default and rebuilt on every refresh, so it never remembers its state. -->
                            <ui:CardExpander
                                Margin="0,4,0,0"
                                Padding="12,8"
                                ContentPadding="12,4,12,8"
                                CornerRadius="10"
                                IsExpanded="False">
                                <ui:CardExpander.Header>
                                    <TextBlock Style="{StaticResource Caption}" Text="{loc:Tr GroupWords}" />
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Classes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ClassEntry}">
                                                <WrapPanel Margin="0,0,0,4">
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        Style="{StaticResource Caption}"
                                                        Text="{Binding Name, StringFormat={}{0}:}" />
                                                    <ItemsControl ItemsSource="{Binding Words}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:WordLine}">
                                                                <StackPanel Margin="0,0,10,0" Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource Body}" FontSize="14" Text="{Binding Text}" />
                                                                    <TextBlock
                                                                        Margin="4,0,0,0"
                                                                        Style="{StaticResource Caption}"
                                                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                        Text="{loc:Tr OwnPhrase}"
                                                                        Visibility="{Binding IsOwn, Converter={StaticResource Visible}}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,2,0,6"
                                        Style="{StaticResource CaptionWrap}"
                                        Text="{Binding ElidedAction}"
                                        Visibility="{Binding ElidedAction, Converter={StaticResource NotEmptyVisible}}" />
                                    <!-- Every command with its 1–2 examples (spec: Command reference). -->
                                    <ItemsControl AlternationCount="10000" ItemsSource="{Binding Commands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CommandEntry}">
                                                <Border Style="{StaticResource ListRow}" MinHeight="36" Padding="0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Body}" FontSize="14" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionWrap}" Text="{Binding ExamplesText}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ui:CardExpander>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Page>
