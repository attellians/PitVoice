<Page
    x:Class="PitVoice.App.Pages.ModelsPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:PitVoice.App.ViewModels"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <!-- An icon button on the right of a row: grey by default, the download icon blue (spec: One primary button). -->
        <Style x:Key="RowIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A model row: the language, "● используется" or the size, the progress while downloading, icon buttons (spec: Models in the window). -->
        <DataTemplate x:Key="ModelRowTemplate" DataType="{x:Type vm:ModelRow}">
            <Border Style="{StaticResource ListRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Body}" Text="{Binding LanguageName}" />
                            <StackPanel Margin="12,0,0,0" Orientation="Horizontal" Visibility="{Binding IsInUse, Converter={StaticResource Visible}}">
                                <Ellipse Fill="{DynamicResource StateOkBrush}" Style="{StaticResource StateDot}" />
                                <TextBlock Foreground="{DynamicResource StateOkBrush}" Style="{StaticResource Caption}" Text="{loc:Tr ModelInUse}" />
                            </StackPanel>
                            <TextBlock
                                Margin="12,0,0,0"
                                Style="{StaticResource Caption}"
                                Text="{Binding SizeText}"
                                Visibility="{Binding SizeText, Converter={StaticResource NotEmptyVisible}}" />
                        </StackPanel>
                        <StackPanel Margin="0,6,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}">
                            <ProgressBar Height="3" Maximum="100" Value="{Binding Percent, Mode=OneWay}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}" Text="{Binding ProgressText}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource ErrorText}"
                            Text="{Binding Error}"
                            Visibility="{Binding Error, Converter={StaticResource NotEmptyVisible}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:Button
                            AutomationProperties.Name="{loc:Tr DownloadButton}"
                            Command="{Binding DownloadCommand}"
                            Style="{StaticResource RowIconButton}"
                            ToolTip="{loc:Tr DownloadButton}"
                            Visibility="{Binding CanDownload, Converter={StaticResource Visible}}">
                            <ui:SymbolIcon FontSize="18" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowDownload24" />
                        </ui:Button>
                        <ui:Button
                            AutomationProperties.Name="{loc:Tr CancelButton}"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource RowIconButton}"
                            ToolTip="{loc:Tr CancelButton}"
                            Visibility="{Binding IsDownloading, Converter={StaticResource Visible}}">
                            <ui:SymbolIcon FontSize="16" Symbol="Dismiss24" />
                        </ui:Button>
                        <ui:Button
                            AutomationProperties.Name="{loc:Tr DeleteButton}"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource RowIconButton}"
                            ToolTip="{loc:Tr DeleteButton}"
                            Visibility="{Binding CanDelete, Converter={StaticResource Visible}}">
                            <ui:SymbolIcon FontSize="16" Symbol="Delete24" />
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Margin="0,0,0,4" Style="{StaticResource PageTitle}" Text="{loc:Tr NavModels}" />
        <TextBlock Margin="0,0,0,16" Style="{StaticResource CaptionWrap}" Text="{loc:Tr ModelsIntro}" />
        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding Message, Converter={StaticResource NotEmpty}}"
            Message="{Binding Message}"
            Severity="Error" />

        <!-- Two groups of one list; an empty group is hidden with its title (spec: Models in the window). -->
        <StackPanel DataContext="{Binding Groups}" Visibility="{Binding HasInstalled, Converter={StaticResource Visible}}">
            <TextBlock Margin="0,0,0,8" Style="{StaticResource SectionTitle}" Text="{loc:Tr ModelsInstalled}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <ItemsControl AlternationCount="10000" ItemTemplate="{StaticResource ModelRowTemplate}" ItemsSource="{Binding Installed}" />
            </Border>
        </StackPanel>
        <StackPanel DataContext="{Binding Groups}" Visibility="{Binding HasAvailable, Converter={StaticResource Visible}}">
            <TextBlock Margin="0,4,0,8" Style="{StaticResource SectionTitle}" Text="{loc:Tr ModelsAvailable}" />
            <Border Style="{StaticResource Card}" Padding="16,4">
                <ItemsControl AlternationCount="10000" ItemTemplate="{StaticResource ModelRowTemplate}" ItemsSource="{Binding Available}" />
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
