<Page
    x:Class="PitVoice.App.Pages.OverlayPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:PitVoice.App.Controls"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="RowIcon" TargetType="controls:SectionIcon">
            <Setter Property="Size" Value="28" />
            <Setter Property="Section" Value="Overlay" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="24,16,24,24">
        <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr NavOverlay}" />

        <ui:InfoBar
            Margin="0,0,0,12"
            IsClosable="False"
            IsOpen="{Binding SaveError, Converter={StaticResource NotEmpty}}"
            Message="{Binding SaveError}"
            Severity="Error" />

        <Border Style="{StaticResource Card}" Padding="16,8">
            <StackPanel>
                <Border Style="{StaticResource ListRowFirst}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>
                        <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Layer24" />
                        <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayEnabled}" />
                        <ui:ToggleSwitch Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Enabled}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Card}" Padding="16,8">
                <StackPanel>
                    <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayLookSection}" />
                    <Border Style="{StaticResource ListRowFirst}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Eye24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayKindLabel}" />
                            <ComboBox
                                Grid.Column="2"
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding Kinds}"
                                SelectedValue="{Binding Kind}"
                                SelectedValuePath="Key"
                                Style="{StaticResource RowCombo}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Scales24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayScaleLabel}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Slider
                                    Maximum="{Binding MaxScale}"
                                    Minimum="{Binding MinScale}"
                                    Style="{StaticResource RowSlider}"
                                    Value="{Binding Scale}" />
                                <TextBlock Width="44" Margin="8,0,0,0" Style="{StaticResource Body}" Text="{Binding Scale, StringFormat={}{0}%}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="Blur24" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowLabel}" Text="{loc:Tr OverlayOpacityLabel}" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Slider
                                    Maximum="{Binding MaxOpacity}"
                                    Minimum="{Binding MinOpacity}"
                                    Style="{StaticResource RowSlider}"
                                    Value="{Binding Opacity}" />
                                <TextBlock Width="44" Margin="8,0,0,0" Style="{StaticResource Body}" Text="{Binding Opacity, StringFormat={}{0}%}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,8">
                <StackPanel>
                    <TextBlock Margin="0,4,0,4" Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayPlaceSection}" />
                    <Border Style="{StaticResource ListRowFirst}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:SectionIcon Style="{StaticResource RowIcon}" Symbol="ArrowMove24" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionWrap}" Text="{loc:Tr OverlayPlaceNote}" />
                            <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <ui:Button HorizontalAlignment="Stretch" Appearance="Primary" Command="{Binding ToggleMoveCommand}" Content="{Binding MoveText}" />
                                <ui:Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Command="{Binding ResetPositionCommand}" Content="{loc:Tr OverlayResetPosition}" IsEnabled="{Binding HasCustomPosition}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
</Page>
