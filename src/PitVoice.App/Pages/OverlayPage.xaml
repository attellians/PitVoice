<Page
    x:Class="PitVoice.App.Pages.OverlayPage"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:PitVoice.App.Localization"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="{loc:Tr NavOverlay}" />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding SaveError, Converter={StaticResource NotEmpty}}"
                Message="{Binding SaveError}"
                Severity="Error" />

            <ui:Card Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr OverlayNote}" TextWrapping="Wrap" />
                    <ui:ToggleSwitch Margin="0,12,0,0" Content="{loc:Tr OverlayEnabled}" IsChecked="{Binding Enabled}" />
                </StackPanel>
            </ui:Card>

            <StackPanel Visibility="{Binding Enabled, Converter={StaticResource Visible}}">
                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayLookSection}" />
                        <TextBlock Margin="0,0,0,4" Text="{loc:Tr OverlayKindLabel}" />
                        <ComboBox
                            Width="320"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Display"
                            ItemsSource="{Binding Kinds}"
                            SelectedValue="{Binding Kind}"
                            SelectedValuePath="Key" />
                        <TextBlock Margin="0,12,0,4" Text="{loc:Tr OverlayScaleLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Slider
                                Width="320"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding MaxScale}"
                                Minimum="{Binding MinScale}"
                                TickFrequency="5"
                                Value="{Binding Scale}" />
                            <TextBlock Width="48" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Scale, StringFormat={}{0}%}" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,4" Text="{loc:Tr OverlayOpacityLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <Slider
                                Width="320"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding MaxOpacity}"
                                Minimum="{Binding MinOpacity}"
                                TickFrequency="5"
                                Value="{Binding Opacity}" />
                            <TextBlock Width="48" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Opacity, StringFormat={}{0}%}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

                <ui:Card Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr OverlayPlaceSection}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Tr OverlayPlaceNote}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Command="{Binding ToggleMoveCommand}" Content="{Binding MoveText}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding ResetPositionCommand}" Content="{loc:Tr OverlayResetPosition}" IsEnabled="{Binding HasCustomPosition}" />
                        </StackPanel>
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
</Page>
