<!--
    The visual system of the window (refresh-window-visual-style, design D1, D3): cards of one tone with a 12 px radius,
    list rows of 44 px and more with a divider, tiles, chips for example phrases and the three text sizes (13 / 15 / 26).
    Colors come only from the WPF-UI theme and the section hue set (Style.Dark.xaml / Style.Light.xaml), always through
    DynamicResource, so a theme switch redraws everything without a restart.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CardRadius">12</CornerRadius>

    <!-- A card: one tone, no colored frame, 12 px radius. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A tile of the home page: a card with a little less padding, stretched in its column. -->
    <Style x:Key="Tile" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="96" />
    </Style>

    <!--
        A row of a list inside a card: at least 44 px, "icon - label - value or control on the right". The divider is the
        top border, hidden on the first row of an ItemsControl (AlternationIndex 0) or with ListRowFirst in static markup.
    -->
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ListRowFirst" TargetType="Border" BasedOn="{StaticResource ListRow}">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- A pill with an example phrase. -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChipStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- A state dot next to a word; its Fill is set where it is used. -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Text: 26 px page title, 15 px body, 13 px caption. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="BodyWrap" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="CaptionWrap" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource CaptionWrap}">
        <Setter Property="Foreground" Value="{DynamicResource StateErrorBrush}" />
    </Style>

    <!-- Controls on the right of a settings row. -->
    <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="RowSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Width" Value="200" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="5" />
    </Style>
</ResourceDictionary>
