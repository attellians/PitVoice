<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>pitvoice-cli</AssemblyName>
    <RootNamespace>PitVoice.Cli</RootNamespace>
    <Description>Console tool: parse text commands, validate language packs, manage models, recognize speech and send pit commands to iRacing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PitVoice.Core\PitVoice.Core.csproj" />
    <ProjectReference Include="..\..\src\PitVoice.IRacing\PitVoice.IRacing.csproj" />
    <ProjectReference Include="..\..\src\PitVoice.Models\PitVoice.Models.csproj" />
    <ProjectReference Include="..\..\src\PitVoice.Speech\PitVoice.Speech.csproj" />
    <ProjectReference Include="..\..\src\PitVoice.Input\PitVoice.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\languages\*.yaml" Link="languages\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\models\manifest.json" Link="models\manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
