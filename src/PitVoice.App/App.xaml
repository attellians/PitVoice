<Application
    x:Class="PitVoice.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:PitVoice.App"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- The hue set is swapped by Themes together with the WPF-UI theme (design D1). -->
                <ResourceDictionary Source="Themes/Style.Dark.xaml" />
                <ResourceDictionary Source="Themes/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="Visible" />
            <app:NotVisibleConverter x:Key="NotVisible" />
            <app:NotEmptyConverter x:Key="NotEmpty" />
            <app:NotEmptyVisibleConverter x:Key="NotEmptyVisible" />
            <app:NarrowerThanConverter x:Key="NarrowerThan" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
